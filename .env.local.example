# MealOS AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# All 6 variables are required at runtime — the app throws at boot if any are missing.

# ─── Database ───────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled URL for serverless functions).
# Get it from: https://console.neon.tech → Connection Details → Connection string
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Anthropic ──────────────────────────────────────────────────────────────────
# Used by ConversationAgent (claude-haiku-4-5), PlanningAgent (claude-sonnet-4-6),
# ToolAgent (claude-haiku-4-5), and MemoryAgent (claude-haiku-4-5).
# Get it from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ─── Clerk ──────────────────────────────────────────────────────────────────────
# Frontend publishable key — safe to expose in client-side code.
# Get it from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Backend secret key — never expose this in client-side code.
# Get it from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY="sk_test_..."

# ─── YouTube ────────────────────────────────────────────────────────────────────
# YouTube Data API v3 key for recipe video search (used by RecipeService).
# Quota: 10,000 units/day. Each search costs 100 units.
# Get it from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY="AIza..."

# ─── Swiggy MCP ─────────────────────────────────────────────────────────────────
# Controls which Swiggy client is used.
# "mock"  → MockSwiggyMCPClient with Mumbai fixtures (safe for local dev, no Swiggy account needed)
# "live"  → Real SwiggyMCPClient (requires Swiggy MCP server credentials — see docs/SWIGGY_MCP.md)
SWIGGY_MCP_MODE="mock"
